# Copy to .env and fill in. docker-compose reads these automatically.

# OpenAI API key used by the RAG service for answer generation.
# If left empty, the RAG endpoint still works as retrieval-only
# (returns matching sources without a generated answer).
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI chat model used for generation.
OPENAI_MODEL=gpt-4o-mini
